cabal-version:      3.0
name:               h-kernel
version:            0.1.0.0
synopsis:           Pure Haskell Double-Entry Household Accounting Engine
description:        A Haskell double-entry accounting engine with explicit account metadata and exact multi-commodity arithmetic.
license:            MIT
license-file:       LICENSE
category:            Finance
build-type:          Simple
extra-source-files: docs/*.md
                  , docs/INDEX.toml
                  , tests/fixtures/editor/*.journal

library
    exposed-modules:  HKernel.Account
                    , HKernel.Account.Journal
                    , HKernel.Actual.Journal
                    , HKernel.Application.Config
                    , HKernel.Budget
                    , HKernel.Budget.Config
                    , HKernel.Budget.Consumption
                    , HKernel.Budget.Distribution
                    , HKernel.Budget.Entitlement
                    , HKernel.Budget.History
                    , HKernel.Budget.Policy
                    , HKernel.Budget.Remaining
                    , HKernel.Budget.Routing
                    , HKernel.Budget.TSV
                    , HKernel.CLI
                    , HKernel.Engine
                    , HKernel.Envelope
                    , HKernel.Envelope.Render
                    , HKernel.HouseholdIssue
                    , HKernel.HouseholdIssue.Render
                    , HKernel.Journal
                    , HKernel.Ledger
                    , HKernel.Loader
                    , HKernel.Money
                    , HKernel.Period
                    , HKernel.Plan
                    , HKernel.Plan.Journal
                    , HKernel.Plan.Completion
                    , HKernel.Plan.Reservation
                    , HKernel.Plan.Render
                    , HKernel.Render
                    , HKernel.Render.TerminalStyle
                    , HKernel.Report
                    , HKernel.Report.Config
                    , HKernel.Report.CycleAccounts
                    , HKernel.Report.Matrix
                    , HKernel.Report.Plan
                    , HKernel.Report.Presentation
    other-modules:    HKernel.Engine.Facts
                    , HKernel.Report.Flow
                    , HKernel.Report.RecentTransactions
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , filepath >= 1.4 && < 1.6
                    , scientific >= 0.3 && < 0.4
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , toml-parser >= 2.0.2 && < 2.1
                    , transformers >= 0.5 && < 0.7
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall -Werror=incomplete-patterns

library h-kernel-household
    exposed-modules:  HKernel.Household.AccountProfile
                    , HKernel.Household.AccountProfile.TSV
                    , HKernel.Household.Backing
                    , HKernel.Household.BudgetMovement
                    , HKernel.Household.BudgetMovement.TSV
                    , HKernel.Household.Config
                    , HKernel.Household.DailyTarget
                    , HKernel.Household.DailyTarget.TSV
                    , HKernel.Household.Issue.TSV
                    , HKernel.Household.Policy
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , h-kernel
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , toml-parser >= 2.0.2 && < 2.1
    hs-source-dirs:   household-src
    default-language: Haskell2010
    ghc-options:      -Wall -Werror=incomplete-patterns

library h-kernel-editor
    exposed-modules:  HKernel.Editor.ActualAppend
                    , HKernel.Editor.ActualAccountAppend
                    , HKernel.Editor.ActualReverse
                    , HKernel.Editor.ActualWorkspace
                    , HKernel.Editor.ActualWriter
                    , HKernel.Editor.BudgetMovementAppend
                    , HKernel.Editor.CLI
                    , HKernel.Editor.Interaction.ActualAdd
                    , HKernel.Editor.Interaction.PlanCompleteAdvance
                    , HKernel.Editor.IssueAppend
                    , HKernel.Editor.PlanLifecycle
                    , HKernel.Editor.PlanCompleteAdvance
                    , HKernel.Editor.TransactionBlock
    other-modules:    HKernel.Editor.SourceAppend
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , h-kernel
                    , h-kernel-household
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , directory >= 1.3 && < 1.4
    hs-source-dirs:   editor-src
    default-language: Haskell2010
    ghc-options:      -Wall -Werror=incomplete-patterns

library h-kernel-spike-household-report
    exposed-modules:  HKernel.Household.Application
                    , HKernel.Spike.HouseholdReport
                    , HKernel.Spike.HouseholdReport.Render
    other-modules:    HKernel.Spike.HouseholdConsumption
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , h-kernel
                    , h-kernel-household
                    , scientific >= 0.3 && < 0.4
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , toml-parser >= 2.0.2 && < 2.1
                    , transformers >= 0.5 && < 0.7
    hs-source-dirs:   spike-src
    default-language: Haskell2010
    ghc-options:      -Wall -Werror=incomplete-patterns

executable h-kernel
    main-is:          Main.hs
    build-depends:    base >= 4.14 && < 5
                    , directory
                    , filepath >= 1.4 && < 1.6
                    , h-kernel
                    , h-kernel-spike-household-report
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -Wall -Werror=incomplete-patterns

executable repository-audit
    main-is:          Main.hs
    other-modules:    RepositoryAudit
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , filepath >= 1.4 && < 1.6
                    , process
                    , text >= 1.2 && < 2.2
                    , toml-parser >= 2.0.2 && < 2.1
    hs-source-dirs:   tools/repository-audit
    default-language: Haskell2010
    ghc-options:      -Wall -Werror=incomplete-patterns


