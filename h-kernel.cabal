cabal-version:      3.0
name:               h-kernel
version:            0.1.0.0
synopsis:           Pure Haskell Double-Entry Household Accounting Engine
description:        A Haskell double-entry accounting engine with explicit account metadata and exact multi-commodity arithmetic.
license:             MIT
license-file:        LICENSE
category:            Finance
build-type:          Simple
tested-with:         GHC == 9.10.3, GHC == 9.12.4, GHC == 9.14.1
extra-source-files: docs/*.md
                  , docs/INDEX.toml
                  , experiments/ghcup-home/Main.hs
                  , tests/fixtures/editor/*.journal

common common-defaults
    default-language: GHC2024
    ghc-options:      -Wall -Werror=incomplete-patterns

common test-defaults
    import:           common-defaults
    hs-source-dirs:   tests
    other-modules:    Test.Support

library
    import:           common-defaults
    exposed-modules:  HKernel.Account
                    , HKernel.Account.Journal
                    , HKernel.Actual.Journal
                    , HKernel.Application.Config
                    , HKernel.Backing
                    , HKernel.Backing.Identity
                    , HKernel.Backing.Policy
                    , HKernel.CLI
                    , HKernel.Engine
                    , HKernel.Envelope
                    , HKernel.Envelope.Commitment
                    , HKernel.Envelope.Config
                    , HKernel.Envelope.Consumption
                    , HKernel.Envelope.Entitlement
                    , HKernel.Envelope.Entitlement.Journal
                    , HKernel.Envelope.EntitlementHistory
                    , HKernel.Envelope.EntitlementTransfer
                    , HKernel.Envelope.ExpenseRouting
                    , HKernel.Envelope.ExpenseRouting.TSV
                    , HKernel.Envelope.Fulfillment
                    , HKernel.Envelope.FulfillmentRouting
                    , HKernel.Envelope.FulfillmentRouting.TSV
                    , HKernel.Envelope.Headroom
                    , HKernel.Envelope.Identity
                    , HKernel.Envelope.Mode
                    , HKernel.Envelope.Policy
                    , HKernel.Envelope.Remaining
                    , HKernel.Envelope.StockOrigin
                    , HKernel.HouseholdIssue
                    , HKernel.Journal
                    , HKernel.Ledger
                    , HKernel.Loader
                    , HKernel.Money
                    , HKernel.Period
                    , HKernel.Plan
                    , HKernel.Plan.Journal
                    , HKernel.Plan.Completion
                    , HKernel.Plan.Open
                    , HKernel.Plan.Reservation
                    , HKernel.Render
                    , HKernel.Render.TerminalStyle
                    , HKernel.Report
                    , HKernel.Report.Config
                    , HKernel.Report.CycleAccounts
                    , HKernel.Report.Matrix
                    , HKernel.Report.Plan
                    , HKernel.Report.Presentation
    other-modules:    HKernel.Engine.Facts
                    , HKernel.Report.Flow
                    , HKernel.Report.RecentTransactions
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , filepath >= 1.4 && < 1.6
                    , scientific >= 0.3 && < 0.4
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , toml-parser >= 2.0.2 && < 2.1
                    , transformers >= 0.5 && < 0.7
    hs-source-dirs:   src

library h-kernel-household
    import:           common-defaults
    exposed-modules:  HKernel.Household.AccountProfile
                    , HKernel.Household.Backing
                    , HKernel.Household.Config
                    , HKernel.Household.Cycle
                    , HKernel.Household.DailyTarget
                    , HKernel.Household.EnvelopeHistory
                    , HKernel.Household.EnvelopeObservation
                    , HKernel.Household.Issue.Relation.TSV
                    , HKernel.Household.Issue.TSV
                    , HKernel.Household.Policy
                    , HKernel.Household.Report
                    , HKernel.Household.Report.Render
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , h-kernel
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , toml-parser >= 2.0.2 && < 2.1
    hs-source-dirs:   household-src

library h-kernel-editor
    import:           common-defaults
    exposed-modules:  HKernel.Editor.ActualAppend
                    , HKernel.Editor.AccountAppend
                    , HKernel.Editor.ActualReverse
                    , HKernel.Editor.ActualWorkspace
                    , HKernel.Editor.SourcePublication
                    , HKernel.Editor.EntitlementTransferAppend
                    , HKernel.Editor.CLI
                    , HKernel.Editor.Interaction.ActualAdd
                    , HKernel.Editor.Interaction.PlanCompleteAdvance
                    , HKernel.Editor.HouseholdWorkspace
                    , HKernel.Editor.IssueAppend
                    , HKernel.Editor.PlanAppend
                    , HKernel.Editor.PlanEdit
                    , HKernel.Editor.PlanLifecycle
                    , HKernel.Editor.RelationAppend
    build-depends:    base >= 4.14 && < 5
                    , h-kernel
                    , h-kernel-household
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
    hs-source-dirs:   editor-src

library h-kernel-household-application
    import:           common-defaults
    exposed-modules:  HKernel.Household.Application
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , h-kernel
                    , h-kernel-editor
                    , h-kernel-household
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
    hs-source-dirs:   household-application-src

executable h-kernel
    import:           common-defaults
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >= 4.14 && < 5
                    , h-kernel
                    , text >= 1.2 && < 2.2

executable h-kernel-editor
    import:           common-defaults
    main-is:          Main.hs
    other-modules:    HKernel.Editor.TUI.Actual
                    , HKernel.Editor.TUI.Actual.AccountSelector
                    , HKernel.Editor.TUI.Actual.Daily
                    , HKernel.Editor.TUI.Actual.General
                    , HKernel.Editor.TUI.Actual.Income
                    , HKernel.Editor.TUI.Actual.Reconcile
                    , HKernel.Editor.TUI.Actual.Record
                    , HKernel.Editor.TUI.Actual.Reverse
                    , HKernel.Editor.TUI.Actual.Shared
                    , HKernel.Editor.TUI.Home
                    , HKernel.Editor.TUI.Maintenance
                    , HKernel.Editor.TUI.Maintenance.Accounts
                    , HKernel.Editor.TUI.Maintenance.Entitlement
                    , HKernel.Editor.TUI.Maintenance.Issue
                    , HKernel.Editor.TUI.Model
                    , HKernel.Editor.TUI.Plan
                    , HKernel.Editor.TUI.Plan.CompleteAdvance
                    , HKernel.Editor.TUI.Plan.Edit
                    , HKernel.Editor.TUI.Plan.Workspace
                    , HKernel.Editor.TUI.Report
                    , HKernel.Editor.TUI.ReportStyle
                    , HKernel.Editor.TUI.Settings
    hs-source-dirs:   editor-tui-app
    build-depends:    base >= 4.14 && < 5
                    , brick >= 2.1 && < 2.12
                    , h-kernel
                    , h-kernel-editor
                    , h-kernel-household
                    , h-kernel-household-application
                    , microlens >= 0.4 && < 0.5
                    , microlens-mtl >= 0.2 && < 0.3
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , vector >= 0.12 && < 0.14
                    , vty >= 6.2 && < 6.6
                    , vty-crossplatform >= 0.4 && < 0.6

executable h-kernel-editor-dump
    import:           common-defaults
    main-is:          Main.hs
    other-modules:    HKernel.Editor.TUI.ReportStyle
    hs-source-dirs:   editor-dump-app
                  , editor-tui-app
    build-depends:    base >= 4.14 && < 5
                    , h-kernel
                    , h-kernel-editor
                    , h-kernel-household
                    , h-kernel-household-application
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15

executable h-kernel-concierge
    import:           common-defaults
    main-is:          Main.hs
    hs-source-dirs:   concierge-app
    build-depends:    base >= 4.14 && < 5
                    , h-kernel
                    , h-kernel-editor
                    , h-kernel-household
                    , h-kernel-household-application
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15

test-suite h-kernel-test
    import:           test-defaults
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    AccountJournalSpec
                    , ActualJournalSpec
                    , AmountSpec
                    , BackingSpec
                    , BalanceSheetSpec
                    , CLIArgsSpec
                    , CommoditySpec
                    , ConfigSpec
                    , CycleSpec
                    , EditorAccountAppendSpec
                    , EditorActualAppendSpec
                    , EditorActualReverseSpec
                    , EditorActualWorkspaceSpec
                    , EditorCLIArgsSpec
                    , EditorEntitlementTransferAppendSpec
                    , EditorInteractionSpec
                    , EditorIssueAppendSpec
                    , EditorPlanAppendSpec
                    , EditorPlanEditSpec
                    , EditorPlanLifecycleSpec
                    , EditorRelationAppendSpec
                    , EngineSpec
                    , EntitlementConfigSpec
                    , EntitlementJournalSpec
                    , EntitlementSpec
                    , EnvelopeCommitmentSpec
                    , EnvelopeConsumptionSpec
                    , EnvelopeExpenseRoutingSpec
                    , EnvelopeFulfillmentSpec
                    , EnvelopeFulfillmentRoutingSpec
                    , EnvelopeHeadroomSpec
                    , EnvelopeHistorySpec
                    , EnvelopeIdentitySpec
                    , EnvelopePolicySpec
                    , EnvelopeRemainingSpec
                    , EnvelopeStockOriginSpec
                    , HouseholdApplicationSpec
                    , HouseholdBackingSpec
                    , HouseholdConfigSpec
                    , HouseholdCycleSpec
                    , HouseholdDailyTargetSpec
                    , HouseholdIssueRelationTSVSpec
                    , HouseholdIssueTSVSpec
                    , HouseholdPolicySpec
                    , HouseholdReportSpec
                    , JournalSpec
                    , LedgerSpec
                    , LoaderSpec
                    , MoneySpec
                    , PeriodSpec
                    , PlanCompletionSpec
                    , PlanJournalSpec
                    , PlanOpenSpec
                    , PlanReservationSpec
                    , ProfitAndLossSpec
                    , RenderSpec
                    , ReportConfigSpec
                    , ReportCycleAccountsSpec
                    , ReportDailyFlowSpec
                    , ReportMatrixSpec
                    , ReportPlanSpec
                    , ReportPresentationSpec
                    , ReportSectionSpec
                    , ReportSpec
    build-depends:    base >= 4.14 && < 5
                    , containers >= 0.6 && < 0.8
                    , directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , h-kernel
                    , h-kernel-editor
                    , h-kernel-household
                    , h-kernel-household-application
                    , scientific >= 0.3 && < 0.4
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , toml-parser >= 2.0.2 && < 2.1
                    , vector >= 0.12 && < 0.14

test-suite editor-tui-issue-realize-test
    import:           common-defaults
    type:             exitcode-stdio-1.0
    main-is:          EditorTUIIssueRealizeSpec.hs
    other-modules:    HKernel.Editor.TUI.Actual
                    , HKernel.Editor.TUI.Actual.AccountSelector
                    , HKernel.Editor.TUI.Actual.Daily
                    , HKernel.Editor.TUI.Actual.General
                    , HKernel.Editor.TUI.Actual.Income
                    , HKernel.Editor.TUI.Actual.Reconcile
                    , HKernel.Editor.TUI.Actual.Record
                    , HKernel.Editor.TUI.Actual.Reverse
                    , HKernel.Editor.TUI.Actual.Shared
                    , HKernel.Editor.TUI.Home
                    , HKernel.Editor.TUI.Maintenance
                    , HKernel.Editor.TUI.Maintenance.Accounts
                    , HKernel.Editor.TUI.Maintenance.Entitlement
                    , HKernel.Editor.TUI.Maintenance.Issue
                    , HKernel.Editor.TUI.Model
                    , HKernel.Editor.TUI.Plan
                    , HKernel.Editor.TUI.Plan.CompleteAdvance
                    , HKernel.Editor.TUI.Plan.Edit
                    , HKernel.Editor.TUI.Plan.Workspace
                    , HKernel.Editor.TUI.Report
                    , HKernel.Editor.TUI.ReportStyle
                    , HKernel.Editor.TUI.Settings
    hs-source-dirs:   tests
                  , editor-tui-app
    build-depends:    base >= 4.14 && < 5
                    , brick >= 2.1 && < 2.12
                    , containers >= 0.6 && < 0.8
                    , h-kernel
                    , h-kernel-editor
                    , h-kernel-household
                    , h-kernel-household-application
                    , microlens >= 0.4 && < 0.5
                    , microlens-mtl >= 0.2 && < 0.3
                    , scientific >= 0.3 && < 0.4
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
                    , vector >= 0.12 && < 0.14
                    , vty >= 6.2 && < 6.6
                    , vty-crossplatform >= 0.4 && < 0.6
