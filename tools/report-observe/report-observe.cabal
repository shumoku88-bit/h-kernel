cabal-version:      3.0
name:               h-kernel-report-observe
version:            0.1.0.0
build-type:          Simple

executable report-observe
    main-is:          Main.hs
    build-depends:    base >= 4.14 && < 5
                    , h-kernel
                    , h-kernel:h-kernel-spike-household-report
                    , text >= 1.2 && < 2.2
                    , time >= 1.9 && < 1.15
    hs-source-dirs:   .
    default-language: Haskell2010
    ghc-options:      -Wall -Werror=incomplete-patterns -O2
