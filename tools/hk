#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CABAL=${HKERNEL_CABAL:-cabal}
REPORT=${HKERNEL_REPORT_COMMAND:-"$ROOT/report"}

usage() {
  cat <<'EOF'
Usage:
  tools/hk
  tools/hk report [REPORT_ARGS...]
  tools/hk actual-add <ACTUAL_JOURNAL>
  tools/hk actual-reverse [--commit] <ACTUAL_JOURNAL> <NEW_EVENT_ID> <TARGET_EVENT_ID> <YYYY-MM-DD> <DESCRIPTION...>
  tools/hk edit EDITOR_COMMAND [EDITOR_ARGS...]
  tools/hk check
  tools/hk help

Commands:
  report          Run the existing Haskell report entrypoint. This is the default.
  actual-add      Run the existing Actual add TUI for one explicit Journal path.
  actual-reverse  Route an explicit Actual reversal intent to the existing Editor CLI.
  edit            Pass all remaining arguments to h-kernel-editor-cli.
  check           Run the repository's standard build, test, and ownership audit.
  help            Show this help.
EOF
}

if [ "$#" -eq 0 ]; then
  exec "$REPORT"
fi

command=$1
shift

case "$command" in
  report)
    exec "$REPORT" "$@"
    ;;
  actual-add)
    if [ "$#" -ne 1 ]; then
      printf 'tools/hk actual-add requires exactly one ACTUAL_JOURNAL path\n' >&2
      exit 2
    fi
    cd "$ROOT"
    exec "$CABAL" run exe:h-kernel-editor-tui -- "$1"
    ;;
  actual-reverse)
    cd "$ROOT"
    exec "$CABAL" run exe:h-kernel-editor-cli -- reverse "$@"
    ;;
  edit)
    cd "$ROOT"
    exec "$CABAL" run exe:h-kernel-editor-cli -- "$@"
    ;;
  check)
    if [ "$#" -ne 0 ]; then
      printf 'tools/hk check does not accept arguments\n' >&2
      exit 2
    fi
    cd "$ROOT"
    "$CABAL" build all
    "$CABAL" test all
    exec "$CABAL" run exe:repository-audit
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'unknown tools/hk command: %s\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
