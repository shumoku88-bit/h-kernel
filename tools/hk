#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CABAL=${HKERNEL_CABAL:-cabal}
REPORT=${HKERNEL_REPORT_COMMAND:-"$ROOT/report"}

BASE_DIR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base) [ "$#" -ge 2 ] || { printf 'error: --base requires a directory path argument\n' >&2; exit 2; }; BASE_DIR=$2; shift 2 ;;
    --base=*) BASE_DIR=${1#--base=}; shift 1 ;;
    *) break ;;
  esac
done

get_data_dir() {
  if [ -n "$BASE_DIR" ]; then echo "$BASE_DIR"; return 0; fi
  if [ -n "${HKERNEL_LEDGER_DATA_DIR:-}" ]; then echo "$HKERNEL_LEDGER_DATA_DIR"; return 0; fi
  if [ -f "$ROOT/ledger-data.local" ]; then awk 'NF { print; exit }' "$ROOT/ledger-data.local"; return 0; fi
  return 1
}

require_data_dir() {
  dir=$(get_data_dir || true)
  [ -n "$dir" ] || { printf 'error: ledger data directory not configured. Specify --base DIR, set HKERNEL_LEDGER_DATA_DIR, or create ledger-data.local\n' >&2; exit 2; }
  echo "$dir"
}

repository_map() {
  cd "$ROOT"
  printf 'cabal-components\n'
  awk '
    function trim(value) {
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      return value
    }
    function start_component(kind, name) {
      current_kind = kind
      current_name = name
      field = ""
      printf "%s %s\n", kind, name
    }
    function emit(label, value) {
      value = trim(value)
      sub(/^,[ \t]*/, "", value)
      if (value != "") {
        printf "  %s %s\n", label, value
      }
    }
    /^[^ \t]/ {
      field = ""
      if ($1 == "library") {
        name = $2
        if (name == "") name = "h-kernel"
        start_component("library", name)
      } else if ($1 == "executable") {
        start_component("executable", $2)
      } else if ($1 == "test-suite") {
        start_component("test-suite", $2)
      } else {
        current_kind = ""
        current_name = ""
      }
      next
    }
    current_kind != "" && /^[ \t]+[A-Za-z0-9-]+:/ {
      line = $0
      sub(/^[ \t]+/, "", line)
      key = line
      sub(/:.*/, "", key)
      value = line
      sub(/^[^:]+:[ \t]*/, "", value)
      field = ""
      if (key == "exposed-modules" && current_kind == "library") {
        field = "public"
        emit(field, value)
      } else if (key == "other-modules") {
        field = "internal"
        emit(field, value)
      } else if (key == "hs-source-dirs") {
        field = "source"
        emit(field, value)
      } else if (key == "main-is") {
        field = "main"
        emit(field, value)
      }
      next
    }
    current_kind != "" && field != "" && /^[ \t]+,/ {
      emit(field, $0)
      next
    }
  ' h-kernel.cabal

  printf '\nactive-documents\n'
  awk '
    /^\[\[documents\]\]/ { path = ""; role = ""; next }
    /^path[ \t]*=[ \t]*"/ {
      value = $0
      sub(/^path[ \t]*=[ \t]*"/, "", value)
      sub(/"[ \t]*$/, "", value)
      path = value
      next
    }
    /^role[ \t]*=[ \t]*"/ {
      value = $0
      sub(/^role[ \t]*=[ \t]*"/, "", value)
      sub(/"[ \t]*$/, "", value)
      role = value
      if (path != "") printf "  %s %s\n", role, path
      next
    }
  ' docs/INDEX.toml
}

repository_context() {
  [ "$#" -eq 1 ] || { printf 'error: tools/hk context requires exactly one TERM\n' >&2; exit 2; }
  term=$1
  [ -n "$term" ] || { printf 'error: tools/hk context requires a non-empty TERM\n' >&2; exit 2; }

  cd "$ROOT"
  printf 'query %s\n\nmap-matches\n' "$term"
  repository_map | awk -v query="$term" '
    BEGIN { needle = tolower(query) }
    index(tolower($0), needle) > 0 { print "  " $0 }
  '

  haskell_matches=$(git grep -l -i -F -e "$term" -- '*.hs' '*.lhs' || true)
  printf '\nsource-haskell\n'
  printf '%s\n' "$haskell_matches" | LC_ALL=C sort -u | awk 'NF && $0 !~ /^tests\// { print "  " $0 }'
  printf '\ntest-haskell\n'
  printf '%s\n' "$haskell_matches" | LC_ALL=C sort -u | awk 'NF && $0 ~ /^tests\// { print "  " $0 }'

  document_matches=$(git grep -l -i -F -e "$term" -- 'docs/*.md' AGENTS.md README.md || true)
  printf '\ndocuments\n'
  printf '%s\n' "$document_matches" | LC_ALL=C sort -u | awk 'NF { print "  " $0 }'
}

usage() {
  cat <<'EOF'
Usage:
  tools/hk [--base DIR]                         Open the Actual workspace.
  tools/hk [--base DIR] dialogue                Open the guided Household dialogue.
  tools/hk [--base DIR] report [REPORT_ARGS...]
  tools/hk [--base DIR] actual-add [ACTUAL_JOURNAL]
  tools/hk [--base DIR] actual-multi [ARGS...]
  tools/hk [--base DIR] actual-reverse [ARGS...]
  tools/hk [--base DIR] account [ARGS...]
  tools/hk [--base DIR] plan [ARGS...]
  tools/hk [--base DIR] budget [ARGS...]
  tools/hk [--base DIR] issue [ARGS...]
  tools/hk [--base DIR] edit [ARGS...]
  tools/hk map
  tools/hk context TERM
  tools/hk check
  tools/hk check-report
  tools/hk [--base DIR] check-household
  tools/hk help

Commands:
  dialogue         Open the guided Haskeline flow for common Household writes.
  report           Run the existing Haskell report entrypoint.
  actual-add       Open the Actual workspace for an explicit journal path.
  actual-multi     Route multi-posting Actual transaction append directly to h-kernel-editor-cli.
  actual-reverse   Route an explicit Actual reversal intent directly to h-kernel-editor-cli.
  account          Route Account declaration directly to h-kernel-editor-cli.
  plan             Route Plan operations (add / finish) directly to h-kernel-editor-cli.
  budget           Route Household budget movement directly to h-kernel-editor-cli.
  issue            Route Issue operations directly to h-kernel-editor-cli.
  edit             Pass arguments directly to h-kernel-editor-cli.
  map              Print a generated Cabal and active-document ownership map.
  context          Select current source, tests, and documents that mention TERM.
  check            Run the standard build, test, and repository ownership audit.
  check-report     Run the complete fixture and corpus Report contract verification.
  check-household  Admit the configured private Household source without printing it.
  help             Show this help.
EOF
}

if [ "$#" -eq 0 ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    printf 'tools/hk workspace requires a TTY. Use subcommands in non-interactive environments.\n' >&2
    usage >&2
    exit 2
  fi
  data_dir=$(require_data_dir)
  cd "$ROOT"
  exec "$CABAL" run exe:h-kernel-editor-tui -- "$data_dir/actual.journal"
fi

command=$1
shift

case "$command" in
  dialogue)
    [ "$#" -eq 0 ] || { printf 'tools/hk dialogue does not accept arguments\n' >&2; exit 2; }
    data_dir=$(require_data_dir)
    cd "$ROOT"
    exec "$CABAL" run exe:h-kernel-editor-haskeline -- "$data_dir"
    ;;
  report)
    dir=$(get_data_dir || true)
    if [ -n "$dir" ]; then
      export HKERNEL_LEDGER_DATA_DIR="$dir"
    fi
    exec "$REPORT" "$@"
    ;;
  actual-add)
    if [ "$#" -eq 1 ]; then journal=$1
    elif [ "$#" -eq 0 ]; then journal=$(require_data_dir)/actual.journal
    else printf 'tools/hk actual-add accepts at most one ACTUAL_JOURNAL path\n' >&2; exit 2; fi
    cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-tui -- "$journal" ;;
  actual-multi) cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-cli -- append "$@" ;;
  actual-reverse) cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-cli -- reverse "$@" ;;
  account) cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-cli -- account "$@" ;;
  plan) cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-cli -- plan "$@" ;;
  budget) cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-cli -- budget "$@" ;;
  issue) cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-cli -- issue "$@" ;;
  edit) cd "$ROOT"; exec "$CABAL" run exe:h-kernel-editor-cli -- "$@" ;;
  map)
    [ "$#" -eq 0 ] || { printf 'error: tools/hk map does not accept arguments\n' >&2; exit 2; }
    repository_map
    ;;
  context)
    repository_context "$@"
    ;;
  check)
    [ "$#" -eq 0 ] || { printf 'tools/hk check does not accept arguments\n' >&2; exit 2; }
    cd "$ROOT"
    python3 tools/verify_repository_context.py
    "$CABAL" build all
    "$CABAL" test all
    exec "$CABAL" run exe:repository-audit
    ;;
  check-report)
    [ "$#" -eq 0 ] || { printf 'tools/hk check-report does not accept arguments\n' >&2; exit 2; }
    cd "$ROOT"
    ./report-build
    ./report-verify --fixture
    exec ./report-verify --corpus
    ;;
  check-household)
    [ "$#" -eq 0 ] || { printf 'tools/hk check-household does not accept arguments\n' >&2; exit 2; }
    data_dir=$(require_data_dir)
    cd "$ROOT"
    export HKERNEL_LEDGER_DATA_DIR="$data_dir"
    exec "$CABAL" run exe:h-kernel -- all >/dev/null
    ;;
  help|-h|--help) usage ;;
  *) printf 'unknown tools/hk command: %s\n\n' "$command" >&2; usage >&2; exit 2 ;;
esac
