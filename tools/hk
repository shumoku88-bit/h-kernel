#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CABAL=${HKERNEL_CABAL:-cabal}
BASE_DIR=""

usage() {
  cat <<'EOF'
Usage:
  tools/hk [--base DIR]

Open the h-kernel Brick TUI for the configured Household.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --base)
      [ "$#" -ge 2 ] || { printf 'error: --base requires a directory path argument\n' >&2; exit 2; }
      BASE_DIR=$2
      shift 2
      ;;
    --base=*)
      BASE_DIR=${1#--base=}
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'error: tools/hk is the TUI launcher only; unexpected argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

get_data_dir() {
  if [ -n "$BASE_DIR" ]; then
    printf '%s\n' "$BASE_DIR"
    return 0
  fi
  if [ -n "${HKERNEL_LEDGER_DATA_DIR:-}" ]; then
    printf '%s\n' "$HKERNEL_LEDGER_DATA_DIR"
    return 0
  fi
  if [ -f "$ROOT/ledger-data.local" ]; then
    awk 'NF { print; exit }' "$ROOT/ledger-data.local"
    return 0
  fi
  return 1
}

data_dir=$(get_data_dir || true)
[ -n "$data_dir" ] || {
  printf 'error: ledger data directory not configured. Specify --base DIR, set HKERNEL_LEDGER_DATA_DIR, or create ledger-data.local\n' >&2
  exit 2
}

if [ ! -t 0 ] || [ ! -t 1 ]; then
  printf 'error: tools/hk opens the interactive TUI and requires a TTY\n' >&2
  exit 2
fi

cd "$ROOT"
exec "$CABAL" run exe:h-kernel-editor-tui -- "$data_dir/actual.journal"
